# Copia questo file in .env e inserisci i tuoi valori.

# Connessione a PostgreSQL, es. postgresql://utente:password@localhost:5432/slack
DATABASE_URL=

# Segreto per firmare i token di accesso: almeno 32 caratteri casuali.
# Generalo con: openssl rand -hex 32
JWT_SECRET=

PORT=5000
NODE_ENV=development
